UNSTRUCTURED_API_KEY=api-key
UNSTRUCTURED_API_URL=https://platform.unstructuredapp.io/api/v1

# Google Cloud Storage Configuration
GOOGLE_CLOUD_PROJECT=name
GCS_BUCKET_NAME=bucket

# Local Development: Use file path
GOOGLE_APPLICATION_CREDENTIALS=file.json

# Deployment: Use base64-encoded JSON (for Cloud Run, GitHub Actions, etc.)
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=base64_encoded_json_here

PINECONE_INDEX_NAME=index-name
PINECONE_API_KEY=api-key

# GCP Pub/Sub Configuration
# Local Development: Use file path
GCP_PUB_SUB_CREDENTIALS=/path/to/your/pubsub-service-account.json

# Deployment: Use base64-encoded JSON (for Cloud Run, GitHub Actions, etc.)
# GCP_PUB_SUB_CREDENTIALS_BASE64=base64_encoded_json_here

PUBSUB_PROJECT_ID=your_gcp_project_id
PUBSUB_TOPIC=workflow-jobs
PUBSUB_SUBSCRIPTION=workflow-jobs-sub